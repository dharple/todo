APP_NAME=TodoList
APP_ENV=local
#APP_ENV=prod
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
# LOG_CHANNEL=daily
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=todo
DB_USERNAME=root
DB_PASSWORD=

# DB_CONNECTION=sqlite
# DB_DATABASE=/path/to/sqlite.db

SESSION_DRIVER=file
# SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# CACHE_STORE=file
CACHE_STORE=redis

REDIS_CLIENT=phpredis
#REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

# Proxies in front of the app: comma-separated IPs or CIDR ranges, or * for any.
# Leave empty on Laravel Cloud, Forge, Vapor, or when not behind a proxy.
TRUSTED_PROXIES=

# Header holding only the visitor's IP, set by the outermost proxy (for example
# CF-Connecting-IP behind Cloudflare).  Only set this if clients can't reach the
# app without going through that proxy.  Laravel Cloud is detected automatically.
TRUSTED_PROXY_CLIENT_IP_HEADER=
